{
    "name": "dmkulyk/code-metrics-report",
    "description": "Code metrics report Livewire package for Nova admin users.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "livewire/livewire": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Ts\\CodeMetricsReport\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ts\\CodeMetricsReport\\Providers\\CodeMetricsReportServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
